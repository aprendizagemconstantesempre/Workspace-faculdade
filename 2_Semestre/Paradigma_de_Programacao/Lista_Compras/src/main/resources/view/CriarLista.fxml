<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela onde a lista e realmente montada.
    Atende aos requisitos RF014 (montar), RF015 (consultar itens com totalizadores),
    RF016 (editar item) e RF017 (excluir item).
-->
<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.listacompras.controller.CriarListaController"
      stylesheets="@../css/estilo.css" styleClass="tela"
      spacing="6" prefWidth="960" prefHeight="680">

    <padding>
        <Insets top="28" right="36" bottom="28" left="36" />
    </padding>

    <Label text="MENU" styleClass="trilha" />
    <Label text="Criar lista de compras" styleClass="titulo-tela" />
    <Label text="Escolha uma lista, o estabelecimento (opcional) e adicione os produtos desejados."
           styleClass="subtitulo-tela" />

    <Region prefHeight="10" />

    <!--
        Primeiro cartao: escolha da lista e do estabelecimento.
        O requisito RF014 diz que o estabelecimento nao e obrigatorio,
        por isso marcamos apenas a lista com asterisco.
    -->
    <HBox styleClass="cartao" spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Lista de compras *" styleClass="rotulo-campo" />
            <ComboBox fx:id="comboLista" promptText="Selecione a lista" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Estabelecimento" styleClass="rotulo-campo" />
            <ComboBox fx:id="comboEstabelecimento" promptText="Selecione o estabelecimento" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <Region prefHeight="12" />

    <!-- Segundo cartao: dados do item que estamos incluindo na lista -->
    <HBox styleClass="cartao" spacing="16" alignment="BOTTOM_LEFT">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Produto" styleClass="rotulo-campo" />
            <ComboBox fx:id="comboProduto" promptText="Selecione o produto" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6">
            <Label text="Quantidade *" styleClass="rotulo-campo" />
            <TextField fx:id="campoQuantidade" text="1" prefWidth="130" />
        </VBox>
        <VBox spacing="6">
            <Label text="Valor unit. (R$)" styleClass="rotulo-campo" />
            <TextField fx:id="campoValorUnitario" promptText="0,00" prefWidth="130" />
        </VBox>
        <Button fx:id="btnAdicionarItem" text="+ Adicionar item" onAction="#adicionarItem"
                styleClass="botao-principal" prefWidth="150" />
    </HBox>

    <Region prefHeight="14" />

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="rotuloItens" text="Itens da lista" styleClass="titulo-secao" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="rotuloContador" text="0 item(ns)" styleClass="contador" />
    </HBox>

    <!-- Tabela com os itens ja incluidos na lista escolhida (RF015) -->
    <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaProduto" text="PRODUTO" prefWidth="230" />
            <TableColumn fx:id="colunaUnidade" text="UNID." prefWidth="110" />
            <TableColumn fx:id="colunaQuantidade" text="QUANTIDADE" prefWidth="130" />
            <TableColumn fx:id="colunaValorUnitario" text="VALOR UNIT." prefWidth="130" />
            <TableColumn fx:id="colunaSubtotal" text="SUBTOTAL" prefWidth="130" />
        </columns>
    </TableView>

    <Region prefHeight="10" />

    <!-- Barra escura do rodape com os totalizadores pedidos no RF015 -->
    <HBox styleClass="barra-totais" spacing="40" alignment="CENTER_RIGHT">
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label text="TOTAL DE ITENS" styleClass="rotulo-total" />
            <Label fx:id="rotuloTotalItens" text="0" styleClass="valor-total" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label text="VALOR TOTAL" styleClass="rotulo-total" />
            <Label fx:id="rotuloValorTotal" text="R$ 0,00" styleClass="valor-total" />
        </VBox>
    </HBox>

    <Region prefHeight="10" />

    <HBox spacing="10">
        <Button fx:id="btnVoltar" text="Voltar ao menu" onAction="#voltarAoMenu"
                styleClass="botao-secundario" prefWidth="140" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEditarItem" text="Editar item" onAction="#editarItem"
                styleClass="botao-secundario" prefWidth="140" />
        <Button fx:id="btnExcluirItem" text="Excluir item" onAction="#excluirItem"
                styleClass="botao-excluir" prefWidth="140" />
    </HBox>

</VBox>
